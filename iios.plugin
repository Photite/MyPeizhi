#!name=iios.club 定时签到
#!desc=自动抓取 iios.club 登录凭证，每天 00:10 调用网站原版 WASM 签到
#!author=Photite
#!homepage=https://github.com/Photite/MyPeizhi

[MITM]
hostname = www.iios.club

[Script]
http-request ^https:\/\/www\.iios\.club\/api\/ tag=iios凭证, script-path=https://raw.githubusercontent.com/Photite/MyPeizhi/main/iios.cookie.js, requires-body=false, timeout=10, enable=true
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/Photite/MyPeizhi/main/iios.js, tag=iios签到, timeout=60, enable=true
