#!name=骁友会（骁龙）自动签到
#!desc=打开微信骁友会小程序自动获取凭据，每天 09:05 查询状态并签到。
#!author=Photite
#!homepage=https://github.com/Photite/MyPeizhi
#!tag=签到

[Script]
http-request ^https:\/\/qualcomm\.boysup\.cn\/qualcomm-app\/api\/(?:user\/(?:info|signList|signIn)|home\/taskDaily)(?:\?|$) script-path=https://raw.githubusercontent.com/Photite/MyPeizhi/refs/heads/main/xiaolong.js?v=20260903.1, tag=骁友会凭据, enable=true
cron "5 9 * * *" script-path=https://raw.githubusercontent.com/Photite/MyPeizhi/refs/heads/main/xiaolong.js?v=20260903.1, tag=骁友会签到, timeout=60, enable=true

[MITM]
hostname = qualcomm.boysup.cn

